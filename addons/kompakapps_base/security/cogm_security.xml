<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- COGM periodik (Q64, D92): semua tabelnya milik satu perusahaan, jadi hanya perusahaan yang diizinkan (dan aktif) yang terlihat. Aturan global tanpa grup. -->
    <record id="cogm_config_company_rule" model="ir.rule">
        <field name="name">COGM Pengaturan: perusahaan</field>
        <field name="model_id" ref="model_kompakapps_cogm_config" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cogm_account_company_rule" model="ir.rule">
        <field name="name">COGM Pemetaan Akun: perusahaan</field>
